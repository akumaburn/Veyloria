{
  "name": "veyloria-frontend",
  "version": "1.0.0",
  "description": "Veyloria Frontend - React + TypeScript + GraphQL",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "bun run typecheck && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "test": "NODE_ENV=test bunx vitest",
    "test:ui": "NODE_ENV=test bunx vitest --ui",
    "test:coverage": "NODE_ENV=test bunx vitest --coverage",
    "lint": "bunx eslint .",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "typecheck": "bunx tsc --noEmit",
    "codegen": "bunx graphql-codegen --config codegen.yml",
    "check:graphql": "bun scripts/check-graphql.ts",
    "typecheck:e2e": "bunx tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "node ../scripts/review/run.mjs --browser-only",
    "review": "node ../scripts/review/run.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "graphql": "^16.15.0",
    "graphql-ws": "^6.4.3",
    "immer": "^11.2.10",
    "js-base64": "^3.9.7",
    "lucide-react": "^1.78.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "react-syntax-highlighter": "^16.1.2",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/js-base64": "^3.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "bun": ">=1.4.5",
    "node": "^24.0.0"
  },
  "author": "Amir Farhad Eslampanah",
  "license": "Apache-2.0",
  "overrides": {
    "@graphql-tools/utils": "^12.1.0",
    "postcss-selector-parser": "^6.1.5",
    "graphql-config": {
      "minimatch": "^11.0.9"
    }
  }
}
