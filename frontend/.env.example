# Frontend environment (Vite reads these at build time).
#
# Every variable here is OPTIONAL. The defaults work in both:
#   - `bun run dev` — Vite proxies /graphql and WebSocket to :8300
#   - `docker compose up` — Nginx sidecar proxies /graphql and WebSocket to backend:8300
#
# Only override when the frontend must reach a backend on a different origin
# (e.g. a CDN-served frontend hitting an API on a different domain).

# HTTP GraphQL endpoint. Relative paths route through the dev/prod proxy.
# VITE_API_URL=/graphql
# VITE_GRAPHQL_ENDPOINT=/graphql   # legacy alias, same semantics as VITE_API_URL

# WebSocket GraphQL endpoint. If unset, the client uses
#   `${protocol}//${window.location.host}/graphql`
# which works under both Vite (:3000) and Nginx (:80/:443).
# VITE_WS_URL=ws://localhost:3000/graphql
