# Frontend Dockerfile
FROM oven/bun:1.4.5-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/bun.lock ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code
COPY frontend/ .

# Build the application.
#
# The frontend uses relative GraphQL endpoints by default (/graphql over HTTP,
# and `${protocol}//${window.location.host}/graphql` for WebSocket), so the
# built-in Nginx sidecar proxy handles routing without needing baked-in URLs.
#
# Override only if the frontend must talk to a backend on a different origin
# (e.g. CDN-served frontend + separate API domain). Leaving these unset is
# the correct choice for self-contained docker-compose deployments.
ARG VITE_API_URL=
ARG VITE_WS_URL=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL

RUN bun run build

# Runtime stage - nginx
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Only send a Connection: upgrade header when the client actually requested
# an upgrade (i.e. WebSocket). HTTP GraphQL requests should not get a stray
# upgrade header, so map to "close" when $http_upgrade is empty.
COPY <<'EOF' /etc/nginx/conf.d/00-upgrade-map.conf
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
EOF

# Copy custom nginx config
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Docker's embedded DNS, so the upstream is resolved per request rather than
    # once at startup. With a literal host in proxy_pass, nginx resolves "backend"
    # while parsing its configuration and aborts outright if it does not resolve
    # ("[emerg] host not found in upstream"). That couples the whole web tier to
    # the API: with the backend absent, nginx refuses to start, so the static app
    # is not served either and the container restarts forever instead of serving
    # what it still can. Resolving late turns that into a 502 on /graphql alone.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # GraphQL HTTP + WebSocket (SmallRye serves both on /graphql).
    location /graphql {
        # Held in a variable deliberately: a variable in proxy_pass is what defers
        # resolution to request time. The address is unchanged, and with no URI
        # part the request URI is passed through exactly as before.
        set $graphql_upstream "backend:8300";
        proxy_pass http://$graphql_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-lived subscriptions: keep the connection open for 24h.
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location /tts/ {
        set $tts_upstream "tts:9797";
        rewrite ^/tts/(.*)$ /$1 break;
        proxy_pass http://$tts_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # SPA routing - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

# Copy built application from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user
RUN addgroup -g 1000 -S chatllm && \
    adduser -u 1000 -S chatllm -G chatllm && \
    chown -R chatllm:chatllm /usr/share/nginx/html && \
    chown -R chatllm:chatllm /var/cache/nginx && \
    chown -R chatllm:chatllm /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown chatllm:chatllm /var/run/nginx.pid

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

EXPOSE 80

USER chatllm

CMD ["nginx", "-g", "daemon off;"]
