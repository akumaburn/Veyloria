# Veyloria Environment Configuration
#
# Copy this file to `.env` and edit. The backend reads these via Quarkus
# `@ConfigProperty` with `application.properties` as the default source.
# Env-var names follow the mapping documented in
# backend/src/main/resources/application.properties.

# ---------------------------------------------------------------
# Environment
# ---------------------------------------------------------------
ENVIRONMENT=production             # development | production
LOG_LEVEL=INFO                     # level for com.eonmux.chatllm.*
DEVELOPMENT_MODE=false               # toggles dev-only paths in the backend
SHOW_GRAPHQL_ERROR_DETAILS=false     # false in production to hide internal error details

# ---------------------------------------------------------------
# MySQL (compose publishes 3307 on host, 3306 inside the compose net)
# ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=chatllm
MYSQL_USER=chatllm
MYSQL_PASSWORD=change-me
DATABASE_HOST=localhost             # "mysql" when running under docker-compose
DATABASE_PORT=3307                  # native backend using Compose MySQL; 3306 for system MySQL
DATABASE_NAME=chatllm
DATABASE_USER=chatllm
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=20

# ---------------------------------------------------------------
# Redis (compose publishes 6380 on host, 6379 inside the compose net)
# ---------------------------------------------------------------
REDIS_HOST=localhost                # "redis" when running under docker-compose
REDIS_PORT=6380                     # native backend using Compose Redis; 6379 for system Redis
REDIS_PASSWORD=change-me-redis
REDIS_DATABASE=0
REDIS_POOL_SIZE=10

# ---------------------------------------------------------------
# JWT (milliseconds; custom auth via JWTAuthProvider + GraphQLAuthContext)
# ---------------------------------------------------------------
JWT_SECRET=
# Required before startup: generate with `openssl rand -base64 48`.
JWT_ISSUER=chatllm
JWT_ACCESS_TOKEN_EXPIRY=14400000    # 4h
JWT_REFRESH_TOKEN_EXPIRY=604800000  # 7d

# ---------------------------------------------------------------
# Quarkus HTTP server
# ---------------------------------------------------------------
QUARKUS_HTTP_PORT=8300
QUARKUS_HTTP_HOST=0.0.0.0
FRONTEND_PORT=80                    # host port published by the frontend (Nginx) container
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
ENABLE_GRAPHQL_PLAYGROUND=false     # set true to expose /q/graphql-ui/

# ---------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=600           # global per-user cap
AUTH_BYPASS_ENABLED=false           # MUST be false in production

# ---------------------------------------------------------------
# LLM (mock replies by default; configure a real provider before disabling mock mode)
# ---------------------------------------------------------------
LLM_ENABLED=true
LLM_MOCK_MODE=true                 # true → canned responses, no real LLM needed
LLM_EXTERNAL_SERVER=true           # true → point at an OpenAI-compatible HTTP API
LLM_EXTERNAL_BASE_URL=http://localhost:8080
LLM_EXTERNAL_MODEL=auto
LLM_EXTERNAL_API_KEY=
LLM_BINARY_PATH=/path/to/llama.cpp/build/bin/llama-server
LLM_MODEL_PATH=/path/to/your-model.gguf
LLM_HOST=127.0.0.1
LLM_PORT=8080
LLM_CONTEXT_SIZE=216000
LLM_BATCH_SIZE=2048
LLM_UBATCH_SIZE=512
LLM_GPU_LAYERS=-1                   # -1 = all layers on GPU
LLM_FLASH_ATTN=on                   # on | off | auto
LLM_CACHE_TYPE_K=q8_0
LLM_CACHE_TYPE_V=q4_0
LLM_FIT=on
LLM_FIT_TARGET=512
LLM_FIT_CTX=4096
LLM_MLOCK=true
LLM_THREADS=6
LLM_TIMEOUT=600
LLM_MAX_CONNECTIONS=4
LLM_MAX_QUEUE_SIZE=100
LLM_REQUEST_TIMEOUT=1800000

# MoE — keep expert weights on CPU (saves VRAM on Mixtral / Qwen3-MoE / etc.)
LLM_CPU_MOE=false
LLM_N_CPU_MOE=-1                    # -1 = disabled; N keeps the first N MoE layers on CPU
LLM_OP_OFFLOAD=true                 # set false to disable tensor-op GPU offload
LLM_DEFRAG_THOLD=-1.0               # KV cache defrag threshold; e.g. 0.1 = 10%
LLM_RPC=                            # comma-separated host:port list for RPC backends

# Multi-modal (vision) projector
LLM_MMPROJ=
LLM_MMPROJ_URL=
LLM_MMPROJ_AUTO=true
LLM_MMPROJ_OFFLOAD=true

# CPU affinity / scheduling
LLM_THREADS_BATCH=-1                # batch-processing threads; -1 = use LLM_THREADS
LLM_CPU_MASK=                       # hex mask, e.g. 0xFF
LLM_CPU_RANGE=                      # range, e.g. 0-7
LLM_CPU_STRICT=0
LLM_PRIO=0                          # 0 normal, 1 medium, 2 high, 3 realtime
LLM_POLL=50                         # busy-wait %
LLM_CPU_MASK_BATCH=
LLM_CPU_RANGE_BATCH=
LLM_CPU_STRICT_BATCH=-1
LLM_PRIO_BATCH=-1
LLM_POLL_BATCH=-1

# Sampling-time generation knobs
LLM_SEED=-1                         # -1 = random per request
LLM_KEEP=-1                         # tokens kept from initial prompt; -1 = all
LLM_IGNORE_EOS=false
LLM_DYNATEMP_RANGE=0.0
LLM_DYNATEMP_EXP=1.0

# Constrained / advanced sampling
LLM_LOGIT_BIAS=
LLM_GRAMMAR=
LLM_GRAMMAR_FILE=
LLM_JSON_SCHEMA=
LLM_JSON_SCHEMA_FILE=
LLM_DRY_SEQUENCE_BREAKER=

# Server features
LLM_ALIAS=                          # served-model-name override
LLM_API_KEY_FILE=                   # alternative to LLM_API_KEY (one key per line)
LLM_API_PREFIX=                     # URL path prefix for API routes
LLM_SLOT_SAVE_PATH=                 # directory for slot-KV persistence
LLM_REUSE_PORT=false                # SO_REUSEPORT for multi-process serving
LLM_NO_HOST=false                   # suppress hostname in /props
LLM_OFFLINE=false                   # skip remote downloads
LLM_PREFILL_ASSISTANT=true          # set false → emit --no-prefill-assistant
LLM_CHAT_TEMPLATE_FILE=             # load chat template from file
LLM_SSL_CERT_FILE=                  # TLS at llama-server (else terminate at proxy)
LLM_SSL_KEY_FILE=

# Speculative decoding (extends LLM_MODEL_DRAFT)
LLM_DRAFT_P_SPLIT=0.1
LLM_CTX_SIZE_DRAFT=0                # 0 = inherit from main
LLM_CACHE_TYPE_K_DRAFT=
LLM_CACHE_TYPE_V_DRAFT=
LLM_DEVICE_DRAFT=
LLM_THREADS_DRAFT=-1
LLM_THREADS_BATCH_DRAFT=-1
LLM_CPU_MOE_DRAFT=false
LLM_N_CPU_MOE_DRAFT=-1

# LoRA
LLM_LORA_INIT_WITHOUT_APPLY=false   # load LoRA but don't apply at startup

# Agent pipeline overrides (blank = fall back to LLM_MODEL_PATH)
AGENT_DEFAULT_MODEL=
AGENT_HIGHLIGHTER_MODEL=
AGENT_MUSE_MODEL=
AGENT_NARRATOR_MODEL=
AGENT_ACCOUNTANT_MODEL=
AGENT_SKEPTIC_MODEL=
AGENT_CASTER_MODEL=
AGENT_SKEPTIC_MAX_RETRIES=2
AGENT_SKEPTIC_NARRATION_GATE_ENABLED=true
AGENT_SKEPTIC_CHARACTER_GATE_ENABLED=true
AGENT_CASTING_ENABLED=true

# RAG
RAG_ENABLED=true
RAG_PROMOTION_ENABLED=true
RAG_PROMOTION_THRESHOLD=0.7
RAG_MAX_RETRIEVED_ENTRIES=15
RAG_MAX_CONTEXT_TOKENS=1500

# ComfyUI image generation
COMFYUI_ENABLED=false
COMFYUI_HOST=localhost
COMFYUI_PORT=8188
COMFYUI_OUTPUT_DIR=./comfyui-output
COMFYUI_MAX_QUEUE_SIZE=5
COMFYUI_DEFAULT_STEPS=20
COMFYUI_DEFAULT_SAMPLER=euler_a

# ---------------------------------------------------------------
# Frontend (Bun package manager; Node.js 24 runs the Vite dev server).
# HTTP and WebSocket requests use the same-origin /graphql proxy by default.
# Set VITE_API_URL / VITE_WS_URL only for an intentional cross-origin setup;
# a direct browser WebSocket URL is not required for normal development.
# SmallRye serves HTTP and WebSocket on the same /graphql path.
# ---------------------------------------------------------------
VITE_API_URL=/graphql
# VITE_WS_URL=ws://localhost:8300/graphql  # set in .env.development, not here

# ---------------------------------------------------------------
# Monitoring (docker-compose only; Prometheus :9091, Grafana :3005)
# ---------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana

# ---------------------------------------------------------------
# llama.cpp container (docker-compose --profile llm)
# ---------------------------------------------------------------
LLM_SERVER_HOST=llama-server
LLM_SERVER_PORT=8080
GPU_LAYERS=0
LLM_THREADS=4
LLM_PARALLEL=2
MODELS_PATH=./models
LLM_MODEL_FILE=model.gguf

# Ming Voice Design (automatic cached download on TTS service startup)
MING_DEVICE=cuda:0
MING_MODEL_REVISION=main
TTS_ALLOWED_ORIGINS=http://localhost:3000,http://rpg.local:3000
# TTS_DEV_URL=http://127.0.0.1:9797
